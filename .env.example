# Copy to .env and supply your own key. Never commit .env.
GOOGLE_API_KEY=
# Use a Gemini model ID available to your account; availability is not checked here.
GENERATION_MODEL_NAME=replace-with-an-available-gemini-model-id
EMBEDDING_MODEL_NAME=vidore/colpali-v1.3

# Auto chooses CUDA, then MPS, then CPU. Explicit unavailable devices fail clearly.
EMBEDDING_DEVICE=auto
EMBEDDING_PRECISION=auto
INGESTION_BATCH_SIZE=2
RENDER_DPI=300
# true loads components during startup. false keeps library-only startup lightweight.
MODEL_WARMUP=false

DATA_DIR=data
MAX_UPLOAD_MB=100
MAX_DOCUMENT_PAGES=1000
MAX_RENDER_PIXELS=40000000

# Phase 2: one persistent local library and one background worker by default.
QDRANT_MODE=local
WORKSPACE_ID=local
INGESTION_WORKER_ENABLED=true
IMPORT_LEGACY_PDFS=true
# QDRANT_IN_MEMORY is deprecated and no longer selects storage.
# memory is disposable/test-only; server mode is not the verified local profile.
QDRANT_HOST=localhost
QDRANT_PORT=6333
# The pooled-v1 suffix is appended to keep older unversioned vectors separate.
QDRANT_COLLECTION_NAME=vision_rag_docs

# Phase 3: retain native text and select visual processing per page.
HYBRID_INGESTION=true
# Conservative Unicode codepoint budgets; overlap must be smaller than limit.
TEXT_CHUNK_LIMIT=1200
TEXT_CHUNK_OVERLAP=120
OCR_ENABLED=true
# Optional local Tesseract installation; missing OCR records a visual fallback.
TESSERACT_EXECUTABLE=tesseract
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=60
